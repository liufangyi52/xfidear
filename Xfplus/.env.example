# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# 高德地图 API Key：AMAP_SERVER_KEY 用于后端地理编码，VITE_AMAP_JS_KEY 用于前端 JS API。
# 申请地址：https://console.amap.com/
AMAP_SERVER_KEY=
VITE_AMAP_JS_KEY=
AMAP_WEATHER_KEY=

# Backend CORS。部署后改成你的 Vercel/Netlify 前端域名。
FRONTEND_ORIGIN=http://localhost:5173

# SQLite 主存储。默认写入 backend/data/app.db；部署时请改为可持久化、可写目录。
DATABASE_URL=sqlite:///D:/SpecialFolder/Documents/xfidear/backend/data/app.db

# 和风天气免费 API Key，作为高德天气不可用时的兜底。
# 申请地址：https://dev.qweather.com/
WEATHER_API_KEY=
QWEATHER_LOCATION_ID=101251101

# 讯飞星火大模型配置。请只写入本地 .env 或部署平台环境变量，不要提交真实密钥。
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_MODEL=generalv3

# 后备 LLM：qwen 或 mock。默认 mock；配置 DASHSCOPE_API_KEY 后可设为 qwen。
FALLBACK_LLM_TYPE=mock
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
AI_TIMEOUT_SECONDS=
