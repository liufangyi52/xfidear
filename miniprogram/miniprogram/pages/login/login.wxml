<view class="page login-page">
  <view wx:if="{{step === 'choose'}}" class="login-simple choose-simple">
    <view class="system-head">
      <text class="system-name">张家界智瞳应急平台</text>
      
    </view>

    <view class="choose-center">
      <view class="choose-title">
        <text class="welcome">请选择身份</text>
        <text class="simple-subtitle">登录后连接团队后端，上报数据市级/区县级管理端可见。</text>
      </view>

      <view class="identity-list">
        <button class="identity-card" bindtap="chooseResident">
          <text class="identity-name">居民</text>
          <text class="identity-desc">接收社区预警，查看周边风险。</text>
        </button>
        <button class="identity-card" bindtap="chooseTourist">
          <text class="identity-name">游客</text>
          <text class="identity-desc">接收景区提醒，发起求助上报。</text>
        </button>
      </view>
    </view>
  </view>

  <view wx:else class="login-simple">
    <view class="simple-title">
      <text class="hello">你好</text>
      <text class="welcome">欢迎{{mode === 'register' ? '注册' : '登录'}}</text>
      <text class="simple-subtitle">{{roleLabel}}入口</text>
    </view>

    <view class="simple-form">
      <label class="line-field">
        <text class="line-label">手机号或昵称</text>
        <input value="{{username}}" placeholder="请输入手机号或昵称" bindinput="onUsername" />
      </label>

      <label class="line-field">
        <text class="line-label">密码</text>
        <input
          password
          value="{{password}}"
          placeholder="{{mode === 'register' ? '请输入8-16位字母加数字密码' : '请输入密码'}}"
          bindinput="onPassword"
        />
      </label>

      <text wx:if="{{mode === 'register'}}" class="rule-hint">昵称支持中文、英文、数字或下划线，2至20位；手机号需为11位大陆手机号。注册后账号写入后端，上级管理端可见。</text>
      <text wx:if="{{mode === 'login'}}" class="rule-hint">居民/游客端必须连接后端登录，上报和 SOS 才会同步到市级、区县级管理端。</text>

      <button class="primary-action" loading="{{loading}}" bindtap="submit">
        {{mode === 'register' ? '注册' : '登录'}}
      </button>

      <button wx:if="{{mode === 'login'}}" class="secondary-action" bindtap="useDemoAccount">使用演示账号</button>
      <button wx:if="{{mode === 'login'}}" class="secondary-action" bindtap="showRegister">注册账号</button>
      <button wx:else class="secondary-action" bindtap="showLogin">返回登录</button>
      <button class="text-action" bindtap="backChoose">换身份</button>

      <text wx:if="{{notice}}" class="notice {{noticeType}}">{{notice}}</text>
    </view>
  </view>
</view>
