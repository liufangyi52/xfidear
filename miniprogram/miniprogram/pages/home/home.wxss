.notice-box {
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
}

.notice-box .notice {
  color: #c24135;
  font-size: 26rpx;
  line-height: 1.6;
}

.home-hero {
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 255, 255, 0.36), transparent 28%),
    linear-gradient(135deg, #1b7fe5 0%, #31a4f6 58%, #0f5cb8 100%);
  border-radius: 12rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  padding: 36rpx 30rpx;
}

.home-hero .eyebrow,
.home-hero .title,
.home-hero .subtitle {
  color: #ffffff;
}

.realtime-alert {
  background: #fff8e8;
  border: 2rpx solid #ffd48a;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 30rpx rgba(194, 117, 18, 0.1);
  margin-bottom: 24rpx;
  padding: 26rpx;
}

.realtime-head,
.section-head {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
}

.realtime-head {
  margin-bottom: 16rpx;
}

.realtime-tag {
  background: #1677d2;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.realtime-time {
  color: #9a6a12;
  font-size: 22rpx;
  line-height: 44rpx;
}

.realtime-title,
.push-title,
.section-title,
.card-title {
  color: #10233c;
  display: block;
  font-weight: 800;
}

.realtime-title {
  color: #9a4d00;
  font-size: 34rpx;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.realtime-content {
  color: #5b4220;
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
}

.realtime-note {
  border-top: 1rpx solid rgba(180, 117, 18, 0.16);
  color: #9a6a12;
  display: block;
  font-size: 22rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
}

.section-title {
  font-size: 32rpx;
}

.section-head {
  margin-bottom: 20rpx;
  width: 100%;
}

.section-head > view {
  flex: 1;
  min-width: 0;
}

.small-button {
  background: #e8f4ff;
  border-radius: 8rpx;
  color: #1677d2;
  flex-shrink: 0;
  font-size: 24rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin-left: auto;
  margin-right: 0;
  padding: 0 20rpx;
}

.small-button::after {
  border: 0;
}

.alert-card {
  border-top: 1rpx solid #e4eef8;
  padding-top: 22rpx;
}

.card-title {
  font-size: 30rpx;
  line-height: 1.45;
  margin-bottom: 10rpx;
}

.time {
  color: #8797aa;
  display: block;
  font-size: 22rpx;
  margin-top: 12rpx;
}

.risk-row {
  align-items: center;
  border-top: 1rpx solid #e4eef8;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  padding: 22rpx 0;
}

.risk-score {
  color: #ff9f43;
  font-size: 34rpx;
  font-weight: 900;
}
