.risk-page {
  background:
    radial-gradient(circle at 20% 0%, rgba(91, 188, 255, 0.24), transparent 34%),
    linear-gradient(180deg, #f4faff 0%, #edf6ff 52%, #f8fbff 100%);
  min-height: 100vh;
}

.risk-map {
  height: 46vh;
  width: 100%;
}

.risk-sheet {
  background: #ffffff;
  border-radius: 12rpx 12rpx 0 0;
  margin-top: -16rpx;
  min-height: 52vh;
  padding: 28rpx;
  position: relative;
}

.sheet-head {
  align-items: flex-start;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  margin-bottom: 18rpx;
  width: 100%;
}

.sheet-head > view {
  flex: 1;
  min-width: 0;
}

.section-title,
.card-title {
  color: #10233c;
  display: block;
  font-weight: 800;
}

.section-title {
  font-size: 32rpx;
}

.small-button {
  background: #e8f4ff;
  border-radius: 8rpx;
  color: #1677d2;
  flex-shrink: 0;
  font-size: 24rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin-left: auto;
  margin-right: 0;
  padding: 0 20rpx;
}

.small-button::after {
  border: 0;
}

.weather-box {
  background: #eef7ff;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.risk-card {
  align-items: center;
  border-bottom: 1rpx solid #e4eef8;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  padding: 24rpx 0;
}

.card-title {
  font-size: 30rpx;
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.risk-score {
  color: #ff9f43;
  font-size: 34rpx;
  font-weight: 900;
}
