<view class="page">
  <view class="panel suggestion-panel">
    <text class="eyebrow">{{isTourist ? '游客反馈' : '居民建议'}}</text>
    <text class="section-title">提交信息建议</text>
    <label class="field">
      <text class="field-label">标题</text>
      <input value="{{suggestion.title}}" placeholder="请输入标题" bindinput="onSuggestionTitle" />
    </label>
    <label class="field">
      <text class="field-label">所属区县</text>
      <picker range="{{districtLabels}}" value="{{districtIndex}}" bindchange="onSuggestionDistrictChange">
        <view class="picker-value">{{districtLabels[districtIndex]}}</view>
      </picker>
    </label>
    <label class="field">
      <text class="field-label">位置或社区</text>
      <input value="{{suggestion.community}}" placeholder="如景区入口、道路或社区名称" bindinput="onSuggestionCommunity" />
    </label>
    <label class="field">
      <text class="field-label">内容</text>
      <textarea value="{{suggestion.content}}" placeholder="请描述发现的问题、所在位置和建议。" bindinput="onSuggestionContent" />
    </label>
    <button class="primary-button" loading="{{sending}}" bindtap="submitSuggestion">提交建议</button>
    <text wx:if="{{notice}}" class="notice">{{notice}}</text>
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="section-copy">
        <text class="eyebrow">消息列表</text>
        <text class="section-title">下发消息与回复</text>
      </view>
      <button class="small-button" bindtap="load">刷新</button>
    </view>

    <view wx:if="{{!messages.length}}" class="empty">暂无消息</view>
    <view wx:for="{{messages}}" wx:key="speech_id" class="message-card {{item.id === 'mock-realtime-warning' ? 'mock-message' : ''}}" data-index="{{index}}" bindtap="showMessageDetail">
      <view class="message-head">
        <view class="message-meta">
          <text class="tag">{{item.status_text}}</text>
          <text class="meta">{{item.created_at}}</text>
        </view>
        <view class="message-actions">
          <button wx:if="{{item.can_cancel}}" class="cancel-button" data-id="{{item.id}}" catchtap="cancelSuggestion">撤销</button>
          <button class="speech-button" data-index="{{index}}" catchtap="toggleSpeech">
            <text wx:if="{{speakingMessageId === item.speech_id && speechStatus === 'loading'}}">生成中</text>
            <text wx:elif="{{speakingMessageId === item.speech_id && speechStatus === 'playing'}}">暂停</text>
            <text wx:elif="{{speakingMessageId === item.speech_id && speechStatus === 'paused'}}">继续</text>
            <text wx:else>播报</text>
          </button>
        </view>
      </view>
      <text class="card-title">{{item.title}}</text>
      <text class="meta">{{item.content}}</text>
      <text wx:if="{{item.reply_content}}" class="reply">回复：{{item.reply_content}}</text>
    </view>
  </view>

  <view wx:if="{{detailOpen}}" class="detail-mask" catchtap="closeMessageDetail">
    <view class="detail-dialog" catchtap="noop">
      <text class="detail-title">消息详情</text>
      <view class="detail-list">
        <view wx:for="{{detailRows}}" wx:key="label" class="detail-row">
          <text class="detail-label">{{item.label}}</text>
          <text class="detail-value">{{item.value}}</text>
        </view>
      </view>
      <button class="detail-close" bindtap="closeMessageDetail">知道了</button>
    </view>
  </view>
</view>
